# 音影寻光 · 导购智能服务配置样例
# 复制为 .env 并按环境填写；所有变量统一 AGENT_ 前缀，详见 app/config.py。

# 运行环境：dev | prod | test（prod 会强制校验内部 token 与 LLM API Key）
AGENT_ENV=dev
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
AGENT_LOG_LEVEL=INFO
# 日志格式：json | console（不填则 dev=console，prod=json）
# AGENT_LOG_FORMAT=json

# Redis（会话 / checkpoint）
AGENT_REDIS_URL=redis://localhost:6379/0
AGENT_REDIS_SOCKET_TIMEOUT_S=1.0

# Java 后端内部 API（服务间调用携带内部 token）
AGENT_JAVA_API_BASE_URL=http://localhost:8080
AGENT_INTERNAL_TOKEN=

# LLM（DeepSeek，OpenAI 兼容协议）
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-chat
AGENT_LLM_TIMEOUT_S=30
AGENT_LLM_MAX_RETRIES=2

# Langfuse 链路观测
AGENT_LANGFUSE_ENABLED=false
AGENT_LANGFUSE_PUBLIC_KEY=
AGENT_LANGFUSE_SECRET_KEY=
AGENT_LANGFUSE_HOST=https://cloud.langfuse.com

# 输入限制（单条用户消息最大字符数）
AGENT_MAX_MESSAGE_CHARS=2000
